# Copy to .env and fill in. Never commit .env.
FLASK_SECRET_KEY=change-me
HOST=127.0.0.1
PORT=5000

# Meme requests
COOLDOWN_SECONDS=60
QUEUE_LIMIT=10
CAPTION_MAX_LENGTH=80
OVERLAY_SECONDS=8
VOTE_WINDOW_HOURS=12
DEMO_MODE=true

# Twitch app from https://dev.twitch.tv/console/apps
# (OAuth Redirect URL must be exactly the TWITCH_REDIRECT_URI below).
# Then open http://localhost:5000/twitch and click "Connect".
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:5000/twitch/callback
TWITCH_REWARD_TITLE=Make a Meme
TWITCH_REWARD_COST=500

# ---- Online deploy only (see DEPLOY.md). Leave blank on your PC. ----
# DATABASE_URL=postgresql://...        # Neon Postgres; SQLite is used when blank
# PUBLIC_URL=https://streamface-memes.onrender.com
# ADMIN_PASSWORD=                      # password for /setup, /editor, /mod, /twitch
# USER_SITE_URL=https://streamface-memes.vercel.app
# MOD_SITE_URL=https://streamface-mod.vercel.app
# MOD_LOGINS=                          # extra Twitch logins allowed on the mod site
